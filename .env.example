# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Newsletter (Beehiiv)
NEWSLETTER_PROVIDER=beehiiv
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Newsletter alternative (Kit / ConvertKit)
KIT_FORM_ID=
KIT_API_KEY=
CONVERTKIT_API_SECRET=

# Lead storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Owner email notifications
# Supported values: resend, postmark
EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
NOTIFY_FROM_EMAIL="The Line List <hello@thelinelist.com>"
NOTIFY_TO_EMAIL=hello@thelinelist.com

# Shared rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics
# Supported values: plausible, posthog, console
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
