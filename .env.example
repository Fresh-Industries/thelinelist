# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL + Better Auth
# Structured application state, product workspaces, guest ownership, accounts, and sessions.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/thelinelist
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Newsletter (Beehiiv)
NEWSLETTER_PROVIDER=beehiiv
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Newsletter alternative (Kit / ConvertKit)
KIT_FORM_ID=
KIT_API_KEY=
CONVERTKIT_API_SECRET=

# Binary file storage (Vercel Blob)
# Product artwork bytes only. Structured state belongs in PostgreSQL.
BLOB_READ_WRITE_TOKEN=
# Optional alternative when using a connected Blob store through Vercel OIDC.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Owner email notifications
# Supported values: resend, postmark
# Newsletter signups, introduction requests, and claims all notify this inbox.
# The Resend key must be authorized to send from the NOTIFY_FROM_EMAIL domain.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
NOTIFY_FROM_EMAIL="The Line List <notifications@mail.thelinelist.com>"
NOTIFY_TO_EMAIL=hello@thelinelist.com

# Shared rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics
# Supported values: plausible, posthog, console
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
