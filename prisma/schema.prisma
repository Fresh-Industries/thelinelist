generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceActor {
  FOUNDER
  AGENT
  SYSTEM
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  accounts      Account[]
  workspaces    ProductWorkspace[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model ProductWorkspace {
  id             String               @id
  userId         String?
  guestTokenHash String?              @unique
  expiresAt      DateTime?
  claimedAt      DateTime?
  status         WorkspaceStatus      @default(ACTIVE)
  revision       Int                  @default(1)
  name           String
  category       String?
  plan           Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities     WorkspaceActivity[]
  assets         WorkspaceAsset[]
  packets        ManufacturerPacket[]

  @@index([userId, updatedAt])
  @@index([expiresAt, status])
}

model WorkspaceActivity {
  id          String           @id @default(cuid())
  workspaceId String
  actor       WorkspaceActor
  kind        String
  summary     String
  details     Json?
  createdAt   DateTime         @default(now())
  workspace   ProductWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model WorkspaceAsset {
  id          String           @id
  workspaceId String
  blobPath    String
  fileName    String
  contentType String
  byteSize    Int
  createdAt   DateTime         @default(now())
  workspace   ProductWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ManufacturerPacket {
  id          String           @id @default(cuid())
  workspaceId String
  tokenHash   String           @unique
  snapshot    Json
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  workspace   ProductWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
}

model LeadSubmission {
  id               String   @id
  kind             String
  manufacturerSlug String
  manufacturerName String
  sourceUrl        String
  utm              Json
  payload          Json
  fingerprint      String
  createdAt        DateTime @default(now())

  @@index([fingerprint, createdAt])
  @@index([manufacturerSlug, createdAt])
}
